# Copy to site.env (gitignored) and fill for the host. Paths as the job sees them. Do not commit real values.
# Empty KEY= lines mean unset; a non-empty process environment wins over the file.

# --- dune-fastsim ---
DUNE_DEVICE_FLOAT=float64
DUNE_LIBRARY_CACHE=

# --- upstream checkouts / caches ---
JAXTPC_ROOT=
LUMEN_CACHE=
LUMEN_DETECTORS=
TALLYMAP_CACHE=

# --- inputs ---
# DUNE ND hall GDML (ND_Production, fetched at a fixed commit) and its detector-frame offset (m)
DUNE_ND_GDML=
DUNE_ND_OFFSET_M=0,-0.668713,6.657559
# edep-sim output of the bdnmc-dune job
EDEPSIM_OUT=

# --- images ---
GEN_IMAGE=
JAX_IMAGE=

# --- hep-endpoints (names only; fill locally) ---
# HEPEP_SLURM_HOST=
# HEPEP_SLURM_ACCOUNT=
# HEPEP_SLURM_GPU_PARTITION=
# HEPEP_SLURM_WORKDIR=
